# Copie para .env e ajuste. Nenhum segredo deve viver aqui: o frontend só conhece a URL da API.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_USE_MOCKS=
# 1 = dev server em HTTPS (https://localhost:5173) com o certificado de scripts/gerar-certificados.sh.
# DEV_HTTPS_CERT/DEV_HTTPS_KEY trocam os caminhos (padrão: ../certs/servidor/servidor.crt e .key).
DEV_HTTPS=
