# dependências
node_modules/

# build
dist/

# banco e ambiente
*.db
*.db-journal
.env

# resultados de teste gerados
e2e/resultados*/
**/selenium-screenshot-*.png

# python / robot
**/__pycache__/
*.log

# worktrees temporários dos agentes do Claude Code
.claude/worktrees/

# certificados TLS locais (B06, scripts/gerar-certificados.sh): a chave da CA e a do
# servidor nunca vão para o repositório. Só o .gitkeep fica, para a pasta montada no
# serviço app existir (sem ela o Docker a criaria como root no Linux).
/certs/*
!/certs/servidor/
/certs/servidor/*
!/certs/servidor/.gitkeep
*.key
*.pem

# área de trabalho do sonar-scanner (B30, scripts/sonarqube.mjs)
.scannerwork/
