# Variáveis lidas pelo docker-compose.yml (copie para `.env` na raiz; o `.env` não vai para o git).

# OBRIGATÓRIA: senha do PostgreSQL local (serviço db). Gere uma: openssl rand -hex 24
# Use a mesma em backend/.env (DATABASE_URL/DIRECT_URL) para rodar a API e os testes fora do Docker.
POSTGRES_PASSWORD=

# Segredo do JWT da API. Vazio = o backend gera um aleatório e o guarda no volume
# (/data/jwt.secret), então não existe segredo fixo no repositório. Para fixar o seu:
#   openssl rand -hex 32
JWT_SECRET=

# development (padrão) ou production. production exige JWT_SECRET forte (>= 16
# caracteres, nada de exemplo) e SMTP real para os e-mails de conta.
NODE_ENV=development

# E-mails (convite, redefinição de senha, campanha simulada). Vazio = Mailpit do compose
# (nada sai da máquina; caixa em http://localhost:8025). Em produção, o SMTP real.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=Baluarte <nao-responda@baluarte.local>

# Base dos links enviados por e-mail (convite, redefinição de senha, campanha).
FRONTEND_URL=http://localhost:8081

# Segunda opinião do VirusTotal na análise de arquivos (B20): só o SHA-256 é consultado, o
# arquivo nunca é enviado. Chave secreta (conta gratuita: 4 consultas/min, 500/dia). Vazio = desligada.
VIRUSTOTAL_API_KEY=

# Origens aceitas no CORS (separadas por vírgula). `*` libera qualquer origem.
CORS_ORIGIN=http://localhost:8081,http://localhost:5173,http://localhost:5174,http://localhost:3000

# Domínio interno das campanhas de phishing simulado: só e-mails deste domínio (e de usuários
# cadastrados) podem ser destinatários. Em dev/teste, vazio = @empresa.com, o do contrato N2 AT1
# (Newman/Robot). Em PRODUÇÃO (NODE_ENV=production) é OBRIGATÓRIO e deve ser o domínio da empresa:
# sem ele, com valor inválido ou com @empresa.com (domínio de um terceiro real) a API recusa subir (DT28).
# Para o frontend validar o mesmo domínio, use VITE_DOMINIO_INTERNO no build do baluarte-frontend.
# DOMINIO_INTERNO=@minhaempresa.com.br

# Seeds do entrypoint Docker. Padrão 0 (DT28): os dois criam contas com as senhas públicas do
# README. Cada um roda só na PRIMEIRA subida com o volume backend-data (marcador em /data).
# 1 = seed de contrato (admin/analista/colaborador, ativos e departamentos da N2 AT1; o Newman e
# o Robot contra o Docker precisam dele).
SEED_CONTRATO=0
# 1 = dados de demonstração (seed:demo). Demo local: SEED_CONTRATO=1 e SEED_DEMO=1.
SEED_DEMO=0
# 1 = o entrypoint RECUSA subir se algum SEED_* for 1 (o docker-compose.servidor.yml liga). Com
# NODE_ENV=production a recusa vale mesmo sem esta variável.
# SEMEAR_PROIBIDO=0

# HTTPS local do frontend do produto (B06; só vale depois de `sh scripts/gerar-certificados.sh`).
# Porta publicada do HTTPS do serviço app (dentro do contêiner, 443).
HTTPS_PORT=8443
# 1 = http://localhost:8081 só redireciona (308) para o HTTPS. Padrão 0: o Playwright em modo
# real e o README usam a 8081 em HTTP. Sem certificado é ignorado.
HTTPS_REDIRECT=0
# Strict-Transport-Security em segundos (só no HTTPS e nunca para `localhost`; 0 faz o navegador esquecer).
HSTS_MAX_AGE=31536000

# Cruzamento do inventário das estações com bases de vulnerabilidades (B14).
# Chave da API do NVD (opcional; sem ela, até 5 consultas ao NVD por verificação). Nunca no código.
NVD_API_KEY=
# 1 liga / 0 desliga o cruzamento automático depois de cada inventário (vazio = ligado no Docker).
CRUZAMENTO_AUTOMATICO=
