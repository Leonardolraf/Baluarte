# Variáveis lidas pelo docker-compose.yml (copie para `.env` na raiz; o `.env` não vai para o git).

# Segredo do JWT da API. Vazio = o backend gera um aleatório e o guarda no volume
# (/data/jwt.secret), então não existe segredo fixo no repositório. Para fixar o seu:
#   openssl rand -hex 32
JWT_SECRET=

# development (padrão): o token de redefinição de senha pode ser impresso no log do
# backend (ver RESET_TOKEN_CONSOLE) — é o único canal de entrega, já que o projeto não
# envia e-mail. production: exige JWT_SECRET forte (>= 16 caracteres, nada de exemplo)
# e nunca imprime tokens.
NODE_ENV=development

# 1 = imprime no log o link de redefinição de senha (só para demonstração local).
RESET_TOKEN_CONSOLE=1

# Base do link de redefinição impresso no log.
FRONTEND_URL=http://localhost:8081

# Origens aceitas no CORS (separadas por vírgula). `*` libera qualquer origem.
CORS_ORIGIN=http://localhost:8081,http://localhost:5173,http://localhost:5174,http://localhost:3000

# 1 = dados de demonstração na primeira subida do backend; 0 = só usuários/ativos do contrato.
SEED_DEMO=1
