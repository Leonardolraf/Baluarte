// Baluarte V2 — modelo de dados real (Prisma + PostgreSQL).
//
// Valores fixos (perfil, status, tipo, severidade, template) ficam como texto e sao
// garantidos NO BANCO por restricoes CHECK criadas nas migrations (prisma/migrations),
// nao por enums do Prisma: os valores do contrato tem acento e espaco ("Em revisão",
// "Banco de Dados") e enums obrigariam uma camada de traducao em todas as rotas.
// As listas validas sao as mesmas de src/util.ts.
//
// E-mail e nome de departamento usam citext: unicidade e busca ignoram maiusculas.

generator client {
  provider      = "prisma-client-js"
  // Runtime Linux da Vercel alem do binario local (o build roda em outra maquina).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexao direta para as migrations (no Supabase, a URL do dia a dia passa pelo pooler).
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique @db.Citext
  senhaHash String
  perfil    String   @default("Analista") // CHECK: Administrador | Analista | Colaborador
  status    String   @default("Ativo")    // CHECK: Ativo | Inativo | Pendente
  criadoEm  DateTime @default(now())
  // Marca a ultima redefinicao de senha: tokens JWT emitidos antes disso deixam de valer.
  senhaAlteradaEm DateTime?
  // Marca o ultimo logout: tokens JWT emitidos antes disso deixam de valer (sair encerra
  // as sessoes abertas em todos os dispositivos).
  sessaoEncerradaEm DateTime?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  preferencias NotificationPreference?
  resetTokens  PasswordResetToken[]
  eventos      CampaignEvent[]
  analises     FileScan[]

  @@index([departmentId])
}

// Departamento do usuario (agrupa os resultados das campanhas). Campos em ingles por
// decisao do projeto. Restrict: departamento com usuarios nao e excluido.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique @db.Citext
  createdAt DateTime @default(now())
  users     User[]
}

// Preferencias de notificacao por e-mail (uma linha por usuario; criada sob demanda
// com os padroes abaixo quando o usuario abre Configuracoes pela primeira vez).
model NotificationPreference {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertasEmail       Boolean  @default(true)
  somenteCriticas    Boolean  @default(false)
  resumoSemanal      Boolean  @default(true)
  relatoriosCampanha Boolean  @default(true)
  atualizadoEm       DateTime @updatedAt
}

// Token de link de conta, entregue por e-mail: RESET (redefinicao de senha, 30 min) ou
// CONVITE (cadastro da primeira senha de quem o administrador criou, 72 h). Guarda-se
// apenas o hash SHA-256; o token em claro so existe no e-mail.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      String    @default("RESET") // CHECK: RESET | CONVITE
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@index([userId])
}

model Asset {
  id       String   @id @default(cuid())
  nome     String
  host     String   @unique
  tipo     String   // CHECK: Servidor | Aplicacao | Rede | Banco de Dados | Estação de trabalho
  status   String   @default("Ativo") // CHECK: Ativo | Inativo
  criadoEm DateTime @default(now())
  scans    Scan[]
  estacao  Workstation?
}

// Estacao de trabalho inscrita pelo agente osquery (B07). Cada estacao e um ativo do tipo
// "Estação de trabalho", criado so pela inscricao (POST /assets nao aceita esse tipo).
// Da chave da estacao (node_key) guarda-se apenas o hash SHA-256; o osquery guarda a chave
// em claro na propria maquina. Restrict: o ativo da estacao nao e excluido com ela inscrita.
model Workstation {
  id             String   @id @default(cuid())
  assetId        String   @unique
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  hostIdentifier String   @unique // --host_identifier do osquery (recomendado: uuid)
  nodeKeyHash    String   @unique
  // Sistema operacional: "sistema" e o rotulo legivel ("Ubuntu 22.04.4 LTS"); os campos so*
  // vem da tabela os_version do osquery (na inscricao e a cada resultado da query de SO).
  sistema        String
  soNome         String?
  soVersao       String?
  soBuild        String?
  soPlataforma   String?  // platform do osquery: windows, darwin, ubuntu, rhel...
  inscritaEm     DateTime @default(now())
  vistaEm        DateTime @default(now()) // ultima requisicao do agente (config ou logger)
  inventarioEm   DateTime? // ultimo resultado de inventario recebido
  programas      WorkstationSoftware[]
  portas         WorkstationPort[]
}

// Inventario mais recente de programas da estacao (cada resultado substitui o anterior da
// mesma fonte). nome + versao + fonte e o que o cruzamento com vulnerabilidades (B14) usa.
model WorkstationSoftware {
  id            String      @id @default(cuid())
  workstationId String
  workstation   Workstation @relation(fields: [workstationId], references: [id], onDelete: Cascade)
  nome          String
  versao        String      // "" quando o sistema nao informa a versao
  fonte         String      // CHECK: programs | deb_packages | rpm_packages | apps
  fornecedor    String?     // publisher (Windows), maintainer (deb), vendor (rpm), bundle id (macOS)
  coletadoEm    DateTime    @default(now())

  @@unique([workstationId, fonte, nome, versao])
  @@index([nome])
}

// Portas em escuta da estacao no ultimo resultado (listening_ports + processes).
model WorkstationPort {
  id            String      @id @default(cuid())
  workstationId String
  workstation   Workstation @relation(fields: [workstationId], references: [id], onDelete: Cascade)
  porta         Int         // CHECK: 1 a 65535
  protocolo     String      // CHECK: TCP | UDP
  endereco      String
  processo      String?
  coletadoEm    DateTime    @default(now())

  @@unique([workstationId, porta, protocolo, endereco])
}

// Restrict: ativo com historico de varredura nao e excluido (inativar preserva o historico).
model Scan {
  id          String    @id @default(cuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  status      String    @default("EM_FILA") // CHECK: EM_FILA | EM_ANDAMENTO | CONCLUIDA
  criadoEm    DateTime  @default(now())
  concluidoEm DateTime?
  findings    Finding[]

  @@index([assetId])
}

// Cascade: o achado so existe dentro da varredura que o gerou.
model Finding {
  id             String   @id @default(cuid())
  scanId         String
  scan           Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  categoriaOwasp String
  cvss           Float    // CHECK: 0 a 10
  severidade     String   // CHECK: Baixo | Médio | Alto | Crítico
  descricao      String
  evidencia      String
  // Classificacao: CWE = tipo de falha; CVE = falha concreta num produto (so achado de
  // componente); vetor CVSS 3.1 = de onde sai a nota (quando existe, a nota e calculada dele).
  cwe            String?
  cve            String?
  cvssVetor      String?
  // Passos de correcao: [{ "titulo", "descricao", "esforco": "baixo"|"medio"|"alto" }].
  // Copiados do catalogo no momento do achado (relatorio antigo nao muda se o catalogo mudar).
  remediacao     Json?
  status         String   @default("Aberta") // CHECK: Aberta | Em revisão | Em remediação | Resolvida | Risco aceito
  criadoEm       DateTime @default(now())

  @@index([scanId])
}

model Campaign {
  id       String          @id @default(cuid())
  nome     String
  template String          // CHECK: urgencia | autoridade | curiosidade
  status   String          @default("AGENDADA") // CHECK: AGENDADA | ATIVA | ENCERRADA
  criadoEm DateTime        @default(now())
  eventos  CampaignEvent[]
}

// Um evento por destinatario da campanha: e a tabela de ligacao Campaign <-> User.
// Cascade na campanha: excluir a campanha leva os eventos dela.
model CampaignEvent {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // So usuarios cadastrados recebem campanha. Restrict: quem tem historico de
  // campanha nao pode ser excluido (inativar a conta preserva as metricas).
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  destinatario String    // copia do e-mail no momento do envio
  // Hash SHA-256 do token do link enviado no e-mail; o token em claro nunca e gravado.
  tokenHash    String?   @unique
  enviadoEm    DateTime?
  abertoEm     DateTime?
  clicadoEm    DateTime?
  submeteuEm   DateTime? // submeteu credenciais no formulario falso
  reportouEm   DateTime? // reportou o e-mail suspeito ao time de TI
  treinou      Boolean   @default(false)
  treinouEm    DateTime? // quando concluiu o treinamento pos-clique

  @@unique([campaignId, userId]) // a mesma pessoa nao entra duas vezes na mesma campanha
  @@index([userId])
}

// Sem chave estrangeira para User de proposito: o registro de auditoria sobrevive a
// exclusao do usuario.
model AuditLog {
  id        String   @id @default(cuid())
  usuarioId String?
  acao      String
  detalhe   String?
  timestamp DateTime @default(now())

  @@index([usuarioId])
  @@index([timestamp])
}

// Falha de login, por e-mail digitado (existente ou nao). Fica no banco para o bloqueio
// por excesso de tentativas valer depois de reiniciar a API. Sem chave estrangeira: o
// e-mail pode nao existir, e o limitador nao pode revelar quais existem.
model LoginFailure {
  id       String   @id @default(cuid())
  email    String   @db.Citext
  criadoEm DateTime @default(now())

  @@index([email, criadoEm])
  @@index([criadoEm])
}

// Pedido de redefinicao, por e-mail digitado. Mesmo motivo de LoginFailure: o limite
// precisa valer entre instancias e sobreviver a reinicio (a API roda como funcao
// serverless, onde estado em memoria nao e compartilhado).
model ResetRequest {
  id       String   @id @default(cuid())
  email    String   @db.Citext
  criadoEm DateTime @default(now())

  @@index([email, criadoEm])
  @@index([criadoEm])
}

// Analise de arquivo pelo antivirus (B04). O arquivo nunca e gravado: passa em fluxo pelo
// ClamAV e e descartado; aqui fica so o registro (nome, tamanho, SHA-256 e o veredito).
// Cascade: excluir o usuario apaga o historico dele (dado pessoal, LGPD).
model FileScan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String   // nome original, so para exibir (nunca vira caminho de arquivo); CHECK ate 255
  tamanho   Int      // bytes; CHECK >= 0
  sha256    String   // CHECK: 64 hexadecimais
  resultado String   // CHECK: LIMPO | AMEACA
  ameaca    String?  // nome da assinatura encontrada (so com AMEACA)
  criadoEm  DateTime @default(now())

  @@index([userId, criadoEm])
  @@index([criadoEm])
  @@index([sha256])
}
