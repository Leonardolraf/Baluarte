# Copie para backend/.env (fora do git). Nada aqui é segredo real.

# --- PostgreSQL local (docker compose up -d db) ---
# <senha> = POSTGRES_PASSWORD do .env da raiz.
DATABASE_URL="postgresql://baluarte:<senha>@localhost:5432/baluarte?schema=public"
# Conexão das migrations; no Postgres local é a mesma URL.
DIRECT_URL="postgresql://baluarte:<senha>@localhost:5432/baluarte?schema=public"

JWT_SECRET="troque-em-producao"
PORT=8080

# Domínio interno das campanhas: só e-mails deste domínio (de usuários cadastrados) podem ser
# destinatários. Com ou sem '@'. Ausente/vazio = @empresa.com (o do contrato; testes e Newman usam esse).
DOMINIO_INTERNO=@empresa.com

# --- Supabase (banco hospedado da demonstração) ---
# Project Settings > Database > Connection string. A SENHA do banco é secreta: só no seu .env.
# API pelo Transaction pooler (6543); migrations pelo Session pooler (5432 — a conexão direta
# do plano gratuito é só IPv6). Depois: npm run db:migrate && npm run seed && npm run seed:demo
# Nunca rode `npm test` com estas URLs (o helper dos testes recusa servidor não local).
# DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# Testes: por padrão usam o servidor do DATABASE_URL (precisa ser local) e criam um banco
# baluarte_test_<arquivo> por arquivo. Para apontar para outro Postgres local:
# TEST_DATABASE_URL="postgresql://baluarte:<senha>@localhost:5432/baluarte?schema=public"

# --- E-mails (convite, redefinição de senha, campanha de phishing simulado) ---
# Mailpit do compose (docker compose up -d mailpit): caixa em http://localhost:8025.
# Sem SMTP_HOST, fora de produção, o e-mail inteiro sai no log da API.
# Em produção onde o SMTP é bloqueado (Railway Hobby), use a API do Brevo: defina
# BREVO_API_KEY (só no painel do provedor, nunca aqui) e EMAIL_REMETENTE com um
# remetente verificado no Brevo. Com BREVO_API_KEY definida, o SMTP é ignorado.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Base dos links nos e-mails (dev server do Vite).
FRONTEND_URL=http://localhost:5173

# --- Antivírus da análise de arquivos (B04) ---
# clamd do Compose: docker compose --profile antivirus up -d (precisa de 3 a 4 GiB de RAM).
# Sem CLAMAV_HOST a análise responde 503 ANTIVIRUS_INDISPONIVEL.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Agente de estação (osquery, plugin tls) ---
# Segredo compartilhado da inscrição (--enroll_secret_path no osquery). Gere com
# `openssl rand -hex 32` e guarde só aqui e no arquivo da estação. Vazio ou com menos de
# 16 caracteres = inscrição desligada (503 INSCRICAO_DESLIGADA).
OSQUERY_ENROLL_SECRET=
# Intervalo das queries do inventário, em segundos (60 a 86400). Padrão: 3600 em
# produção, 300 fora dela.
# OSQUERY_INTERVALO_S=3600
