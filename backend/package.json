{
  "name": "baluarte-v2-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Backend real do Baluarte V2 — plataforma de ciberseguranca (varredura OWASP simulada + phishing simulado + dashboard). Honra o contrato dos testes da N2 AT1.",
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "start": "tsx src/http/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "prisma:generate": "prisma generate",
    "test:seguranca": "node --import tsx --test \"tests/seguranca/**/*.test.ts\"",
    "vercel-build": "prisma generate",
    "test:unidade": "node --import tsx --test \"tests/unidade/**/*.test.ts\"",
    "cobertura:unidade": "c8 --reports-dir=coverage-unidade --reporter=text --reporter=html --reporter=json-summary --all --include=\"src/platform/**/*.ts\" --include=\"src/shared/**/*.ts\" --include=\"src/http/resposta.ts\" --include=\"src/http/middlewares.ts\" --include=\"src/modules/scanner/cvss.ts\" --include=\"src/modules/scanner/catalogo.ts\" --include=\"src/modules/scanner/ciclo.ts\" --include=\"src/modules/campaigns/email.ts\" --include=\"src/modules/auth/jwt.ts\" --include=\"src/modules/auth/links.ts\" --include=\"src/modules/users/repository.ts\" --include=\"src/modules/campaigns/metricas.ts\" --include=\"src/modules/training/conteudo.ts\" --check-coverage --lines 75 --branches 85 --functions 70 node --import tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=coverage-unidade/junit.xml \"tests/unidade/**/*.test.ts\"",
    "cobertura": "c8 --reports-dir=coverage --reporter=text-summary --reporter=html --reporter=json-summary --all --include=\"src/**/*.ts\" --exclude=src/http/server.ts --check-coverage --lines 90 --branches 85 --functions 90 node --import tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=coverage/junit.xml \"tests/**/*.test.ts\"",
    "test:relatorio": "npm run cobertura:unidade && npm run cobertura && node scripts/relatorio-testes.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "c8": "^12.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
